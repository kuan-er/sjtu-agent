# 复制此文件为 .env 并填入真实信息（.env 已在 .gitignore 中，不会被提交）

JACCOUNT_USERNAME=your_jaccount_username  # 不是学号！是登录 my.sjtu.edu.cn 的英文用户名（通常是拼音，如 zhangsan）
JACCOUNT_PASSWORD=your_password

# ── 致远一号 API（推荐，交大官方 OpenAI 兼容接口）───────────────────────────
# 官方调用指南：https://claw.sjtu.edu.cn/guide/sjtu-api/（调用名/限流/校园网要求以此为准）
# 填入后将优先使用致远一号，无需再写 agent_config.json
# Base URL 默认为 https://models.sjtu.edu.cn/api/v1，留空即可
# 可用模型（调用名）：deepseek-chat（V4 Flash 常规）、deepseek-reasoner（V4 Flash 思考）、minimax（MiniMax-M2.7）、qwen（Qwen3.6-27B）；团队受限 403 时可用 public-models（公共池）
ZHIYUAN_API_KEY=your-zhiyuan-api-key
# ZHIYUAN_BASE_URL=https://models.sjtu.edu.cn/api/v1

# ── 其他大模型（可选，未填 ZHIYUAN_API_KEY 时从 agent_config.json 读取）───
# DeepSeek 官方（OpenAI 兼容，model 用 deepseek-flash：V4.1 Flash，原生支持视觉）
# 填了它，web_search 会自动优先用 DeepSeek 官方搜索（一次搜索 = 一个模型轮次，计费）
# DEEPSEEK_API_KEY=sk-...
# Anthropic（可选：填入后验证码将由 Claude 自动识别，否则需手动输入）
# ANTHROPIC_API_KEY=sk-ant-...

# ── 网页搜索后端（可选）──────────────────────────────────────────────────
# auto（默认）：有 DeepSeek 官方 Key 就优先官方搜索，失败回落免 Key 抓取
# scrapers     ：只用免 Key 多引擎抓取（不产生额外 API 花费）
# deepseek     ：只用官方搜索（没有 Key 时搜索不可用）
# SJTU_WEB_SEARCH_BACKEND=auto

# ── 上下文与输出预算（可选，2026 口径默认值，一般不用改）──────────────────
# 折叠阈值按「后端 + 模型」自动算（历史超预算时折叠最旧的对话）：
#   官方 DeepSeek / Anthropic（1M 窗口）→ 500K；官方 OpenAI（1.05M）→ 512K（上限）
#   致远一号 deepseek-chat / deepseek-reasoner（512k）→ 256K
#   致远一号 qwen（256k）→ 128K；其它第三方网关（窗口未公开）→ 64K
# 部署方最清楚自己的窗口时，可以直接声明（优先级高于以上推断）：
# SJTU_CONTEXT_WINDOW=1000000     # 窗口多大
# SJTU_CONTEXT_BUDGET=500000      # 或直接给折叠阈值
# 单轮输出上限：官方端点默认 16384、致远一号默认 8192（其上限官方未公布）。
# 推理模型的思考 token 与正文**共用**这个预算，调太小会出现"只思考不说话"
# （日报空回复事故的根因），一般不建议低于 8192。
# SJTU_MAX_OUTPUT_TOKENS=16384

# ── 交大邮箱监控（可选，mail.sjtu.edu.cn 新邮件推送）─────────────────────
EMAIL_USERNAME=your_sjtu_email_username
EMAIL_PASSWORD=your_sjtu_email_password
# EMAIL_IMAP_HOST=mail.sjtu.edu.cn   # 默认即此值，仅非常规邮箱才需覆盖
# EMAIL_SMTP_HOST=mail.sjtu.edu.cn   # 同上

# ── 中国大学 MOOC（可选）──────────────────────────────────────────────────
# MOOC_USERNAME=your_mooc_username
# MOOC_PASSWORD=your_mooc_password

# ── 路径与工具（可选）─────────────────────────────────────────────────────
# SJTU_AGENT_HOME=      # 覆盖运行时数据目录（默认：平台用户数据目录）
# SJTU_HOMEWORK_DIR=    # 作业文件存放目录
# SJTU_PAPERS_DIR=      # LaTeX 论文模板目标目录
# MATLAB_PATH=          # MATLAB 可执行文件路径（用于生成矢量图）
